.PHONY: build test vet ci clean run-local css css-check

# The version is stamped from the nearest tag (v1.2.3, or v1.2.3-4-gabc123 between tags).
VERSION ?= $(shell git describe --tags --always --dirty 2>/dev/null || echo 0.0.0-dev)

build:
	go build -ldflags "-X github.com/forgelinehq/forgeline/internal/version.Version=$(VERSION)" -o bin/forgeline ./cmd/forgeline

test:
	go test -race ./...

vet:
	go vet ./...

# Everything the CI workflow runs, runnable locally.
ci: vet test build

clean:
	rm -rf bin

# Start the server on this machine only, with a generated token and in-memory history.
# Needs Docker for steps to run. Open the link it prints.
run-local: build
	./bin/forgeline server --data-dir .forgeline-server

# The web console's stylesheet is generated by the Tailwind CSS standalone CLI (no Node) from
# web/tailwind.css and the class names used in internal/server/ui. The generated file is
# committed so the binary builds without the CLI.
CSS_OUT = internal/server/ui/app.css

css:
	"$$(./scripts/tailwind.sh)" -i web/tailwind.css -o $(CSS_OUT) --minify

# Fails if the committed stylesheet is out of date (CI runs this).
css-check:
	"$$(./scripts/tailwind.sh)" -i web/tailwind.css -o $(CSS_OUT).check --minify
	@if cmp -s $(CSS_OUT) $(CSS_OUT).check; then rm $(CSS_OUT).check; echo "app.css is up to date"; \
	else rm $(CSS_OUT).check; echo "app.css is out of date: run make css and commit the result" >&2; exit 1; fi
